# Các cấu hình HTTP là tùy chọn: thiếu vẫn cho startup, endpoint liên quan trả 503.
# Giá trị đã khai báo phải hợp lệ; để comment khi chưa cấu hình, không khai báo rỗng.
# Dùng credential riêng cho từng app và môi trường; không commit giá trị thật.

# Ứng dụng
# Cấu hình process của example; giữ giá trị local đang sử dụng.
NODE_ENV=development
PORT=4102
LOG_LEVEL=info

# Gửi notification tới Rita ID
# API key chỉ dùng phía server để example gọi API Expose của Rita ID.
# Giữ path prefix của URL; HTTP loopback chỉ cho development/test.
# RITA_API_BASE_URL=https://id.example.test/api/
# RITA_INTEGRATION_API_KEY=rik_<integration-uuid>.<64-hex-secret>

# Nhận profile webhook
# Signing secret do Rita ID cấp; chỉ dùng xác minh webhook nhận vào.
# RITA_WEBHOOK_SIGNING_SECRET=whsec_<base64-of-32-random-bytes>

# Bảo vệ API demo
# Bearer token riêng cho API demo; không dùng API key hoặc signing secret thay thế.
# DEMO_API_TOKEN=<32-to-256-base64url-characters>
