NODE_ENV=development
PORT=4102
LOG_LEVEL=info

# Optional transport; no business subscriptions registered.
RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=example_user
RABBITMQ_PASSWORD=replace_me
RABBITMQ_VHOST=/
RABBITMQ_TLS_ENABLED=false
RABBITMQ_PREFETCH=10
RABBITMQ_PUBLISH_TIMEOUT_MS=10000
RABBITMQ_MAX_IN_FLIGHT=100
RABBITMQ_HEARTBEAT_SECONDS=30
RABBITMQ_RECONNECT_SECONDS=5
# Tests read process RABBITMQ_TEST_URL only, never .env.
